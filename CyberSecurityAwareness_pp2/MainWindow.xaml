<Window x:Class="CyberSecurityAwareness_pp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CyberSecurityAwareness_pp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">

        <Window.Resources>

        <!-- Button Style -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#00C896"/>
            <Setter Property="Foreground" Value="#0D1117"/>
            <Setter Property="FontFamily" Value="Segoe UI Semibold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="12,8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#00E5AB"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#00A87A"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TextBox Style -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#161B22"/>
            <Setter Property="Foreground" Value="#E6EDF3"/>
            <Setter Property="CaretBrush" Value="#00C896"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#30363D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="#00C896"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <!-- USERNAME / WELCOME PAGE -->
        <Grid x:Name="name_grid" Visibility="Visible">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Width="420">

                <!-- Logo card -->
                <Border Background="#161B22"
                        CornerRadius="16"
                        Padding="30,24"
                        Margin="0,0,0,28"
                        BorderBrush="#21262D"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="🛡️"
                                   FontSize="48"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="CyberSafe AI"
                                   FontFamily="Segoe UI Black"
                                   FontSize="26"
                                   Foreground="#00C896"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,4"/>
                        <TextBlock Text="Cybersecurity Awareness Chatbot"
                                   FontFamily="Segoe UI"
                                   FontSize="12"
                                   Foreground="#8B949E"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Name entry card -->
                <Border Background="#161B22"
                        CornerRadius="12"
                        Padding="28,24"
                        BorderBrush="#21262D"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Welcome! What's your name?"
                                   FontFamily="Segoe UI Semibold"
                                   FontSize="15"
                                   Foreground="#E6EDF3"
                                   Margin="0,0,0,14"/>

                        <TextBox x:Name="user_name"
                                 Height="44"
                                 Margin="0,0,0,16"
                                 KeyDown="UserName_KeyDown"/>

                        <Button Content="Start Chatting  →"
                                Style="{StaticResource PrimaryButton}"
                                Height="44"
                                Click="submit_name"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </Grid><!-- end of username grid-->

        <!-- CHAT PAGE -->
        <Grid x:Name="chats_grid" Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="#161B22"
                    BorderBrush="#21262D"
                    BorderThickness="0,0,0,1"
                    Padding="20,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="🛡️"
                               FontSize="22"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"/>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="CyberSafe AI"
                                   FontFamily="Segoe UI Black"
                                   FontSize="15"
                                   Foreground="#00C896"/>
                        <TextBlock x:Name="header_status"
                                   Text="Online – Ready to help"
                                   FontFamily="Segoe UI"
                                   FontSize="11"
                                   Foreground="#8B949E"/>
                    </StackPanel>

                    <TextBlock x:Name="header_user"
                               Grid.Column="2"
                               FontFamily="Segoe UI Semibold"
                               FontSize="13"
                               Foreground="#58A6FF"
                               VerticalAlignment="Center"/>
                </Grid>
                <!-- end of chat page-->
            </Border>

            <!-- Chat ListView -->
            <ListView x:Name="chats"
                      Grid.Row="1"
                      Background="#0D1117"
                      BorderThickness="0"
                      Padding="16,12"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      VirtualizingPanel.ScrollUnit="Pixel">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0,3"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <ContentPresenter/>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>

            <!-- Input Bar -->
            <Border Grid.Row="2"
                    Background="#161B22"
                    BorderBrush="#21262D"
                    BorderThickness="0,1,0,0"
                    Padding="16,12">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="question"
                             Grid.Column="0"
                             Height="44"
                             Margin="0,0,10,0"
                             KeyDown="Question_KeyDown"/>

                    <Button Grid.Column="1"
                            Content="Send ➤"
                            Height="44"
                            Width="50"
                            Margin="0,0,60,0"
                            Click="send"/>

                    <Button Grid.Column="2"
                            Content="Exit"
                            Height="44"
                            Width="50"
                            Margin="50,0,0,0"
                            Style="{StaticResource PrimaryButton}"
                            Click="exit"/>

                </Grid>
                <!-- end of input bar grid -->
            </Border>
        </Grid>
    </Grid><!-- end of parent grid -->
</Window>